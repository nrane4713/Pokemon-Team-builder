datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model Preset {
  id        String       @id @default(cuid())
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  teams     PresetTeam[]
}

model PresetTeam {
  id         String       @id @default(cuid())
  presetId   String
  preset     Preset       @relation(fields: [presetId], references: [id], onDelete: Cascade)
  gameKey    String
  label      String?
  orderIndex Int
  slots      PresetSlot[]

  @@index([presetId])
}

model PresetSlot {
  id            String     @id @default(cuid())
  presetTeamId  String
  presetTeam    PresetTeam @relation(fields: [presetTeamId], references: [id], onDelete: Cascade)
  slotIndex     Int
  pokemonFormId String

  @@unique([presetTeamId, slotIndex])
}
